{#
  Entry <id>s are the extensionless post URLs, identical to what jekyll-feed
  published, so feed readers don't re-announce old posts.
#}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.language }}">
  <id>{{ "/feed.xml" | absolute }}</id>
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absolute }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute }}" rel="alternate" type="text/html"/>
  <updated>{{ updated.isoformat() }}T00:00:00+00:00</updated>
  <author>
    <name>{{ site.author.name }}</name>
  </author>
  {% for post in posts %}
  <entry>
    <id>{{ post.url | absolute }}</id>
    <title type="html">{{ post.title }}</title>
    <link href="{{ post.url | absolute }}" rel="alternate" type="text/html" title="{{ post.title }}"/>
    <published>{{ post.date.isoformat() }}T00:00:00+00:00</published>
    <updated>{{ post.date.isoformat() }}T00:00:00+00:00</updated>
    {% for tag in post.tags %}
    <category term="{{ tag }}"/>
    {% endfor %}
    <summary type="html">{{ post.summary }}</summary>
    <content type="html" xml:base="{{ post.url | absolute }}">{{ post.html }}</content>
    <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ post.image | absolute }}"/>
  </entry>
  {% endfor %}
</feed>
